# Dependencies
node_modules/
*/node_modules/

# Environment files - strictly ignore all real credentials
.env
.env.local
.env.*
*.env
*.env.local
**/.env
**/.env.local
**/.env.*
**/*.env
**/*.env.local

# Allow safe example files
!**/.env.example
!**/.env.local.example

# Build outputs
.next/
*/.next/
dist/
*/dist/
out/
*/out/
build/
*/build/

# Debug and runtime logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# TypeScript cache
*.tsbuildinfo
